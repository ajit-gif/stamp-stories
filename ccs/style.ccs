/* =============================================
   STAMP STORIES - Visa Services Website
   Brand Colors: #160B99 (Primary) | #AAD816 (Secondary Accent)
   Font: Inter (Professional Sans-Serif)
   ============================================= */

/* ----- CSS Variables & Reset ----- */
:root {
  --primary: #160B99;
  --primary-dark: #0F0766;
  --primary-light: #2D1CB8;
  --primary-gradient: linear-gradient(135deg, #160B99 0%, #2D1CB8 50%, #3D2FD4 100%);
  --primary-gradient-soft: linear-gradient(135deg, #160B99 0%, #2D1CB8 100%);
  --secondary: #AAD816;
  --secondary-light: #C2F03A;
  --secondary-dark: #8BB812;
  --secondary-gradient: linear-gradient(135deg, #AAD816 0%, #C2F03A 100%);
  
  --text-dark: #1A1A2E;
  --text-body: #333355;
  --text-light: #666688;
  --text-white: #FFFFFF;
  --bg-white: #FFFFFF;
  --bg-light: #F5F7FA;
  --bg-gray: #E8ECF4;
  --bg-dark: #0F0766;
  --border-color: #DDE1EA;
  --shadow-sm: 0 2px 8px rgba(22, 11, 153, 0.08);
  --shadow-md: 0 4px 20px rgba(22, 11, 153, 0.12);
  --shadow-lg: 0 8px 40px rgba(22, 11, 153, 0.18);
  --shadow-xl: 0 12px 60px rgba(22, 11, 153, 0.25);
  --radius-sm: 6px;
  --radius-md: 12px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --max-width: 1200px;
  --header-height: 80px;
}

/* ----- Reset & Base ----- */
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-family);
  color: var(--text-body);
  background: var(--bg-white);
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: var(--primary);
  text-decoration: none;
  transition: var(--transition);
}

a:hover {
  color: var(--primary-light);
}

ul, ol {
  list-style: none;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-family);
  color: var(--text-dark);
  font-weight: 700;
  line-height: 1.25;
}

h1 { font-size: clamp(2.2rem, 5vw, 3.8rem); }
h2 { font-size: clamp(1.8rem, 3.5vw, 2.8rem); }
h3 { font-size: clamp(1.3rem, 2.5vw, 1.8rem); }
h4 { font-size: clamp(1.1rem, 2vw, 1.4rem); }

.container {
  width: 100%;
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 20px;
}

.section-padding {
  padding: 100px 0;
}

.section-header {
  text-align: center;
  margin-bottom: 60px;
}

.section-header h2 {
  margin-bottom: 16px;
}

.section-header p {
  font-size: 1.1rem;
  color: var(--text-light);
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.8;
}

.section-tag {
  display: inline-block;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--primary);
  background: rgba(22, 11, 153, 0.08);
  padding: 6px 18px;
  border-radius: 50px;
  margin-bottom: 16px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

/* ----- Buttons ----- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: var(--font-family);
  font-size: 0.95rem;
  font-weight: 600;
  padding: 14px 32px;
  border-radius: 50px;
  border: 2px solid transparent;
  cursor: pointer;
  transition: var(--transition);
  text-decoration: none;
  line-height: 1.2;
}

.btn-primary {
  background: var(--primary-gradient-soft);
  color: var(--text-white);
  border-color: var(--primary);
}

.btn-primary:hover {
  background: var(--primary-dark);
  border-color: var(--primary-dark);
  color: var(--text-white);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.btn-secondary {
  background: var(--secondary-gradient);
  color: var(--text-dark);
  border-color: var(--secondary);
}

.btn-secondary:hover {
  background: var(--secondary-dark);
  border-color: var(--secondary-dark);
  color: var(--text-dark);
  transform: translateY(-2px);
  box-shadow: 0 4px 20px rgba(170, 216, 22, 0.3);
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border-color: var(--primary);
}

.btn-outline:hover {
  background: var(--primary);
  color: var(--text-white);
  transform: translateY(-2px);
}

.btn-white {
  background: var(--text-white);
  color: var(--primary);
  border-color: var(--text-white);
}

.btn-white:hover {
  background: transparent;
  color: var(--text-white);
  border-color: var(--text-white);
  transform: translateY(-2px);
}

.btn-sm {
  padding: 10px 22px;
  font-size: 0.85rem;
}

/* =============================================
   HEADER / NAVIGATION
   ============================================= */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(22, 11, 153, 0.06);
  transition: var(--transition);
  height: var(--header-height);
}

.site-header.scrolled {
  box-shadow: 0 2px 30px rgba(22, 11, 153, 0.1);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--header-height);
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 20px;
}

.logo {
  display: flex;
  align-items: center;
  text-decoration: none;
}

.logo-text {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--primary);
  letter-spacing: -0.5px;
}

.logo-text span {
  color: var(--secondary);
}

.logo-sub {
  font-size: 0.7rem;
  color: var(--text-light);
  font-weight: 500;
  letter-spacing: 1px;
  text-transform: uppercase;
  display: block;
  margin-top: -2px;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 8px;
}

.main-nav a {
  font-size: 0.92rem;
  font-weight: 500;
  color: var(--text-body);
  padding: 8px 18px;
  border-radius: 50px;
  transition: var(--transition);
  position: relative;
}

.main-nav a:hover,
.main-nav a.active {
  color: var(--primary);
  background: rgba(22, 11, 153, 0.06);
}

.main-nav a.contact-btn-nav {
  background: var(--primary-gradient-soft);
  color: var(--text-white);
  padding: 10px 24px;
  border: none;
}

.main-nav a.contact-btn-nav:hover {
  background: var(--primary-dark);
  color: var(--text-white);
  transform: translateY(-1px);
  box-shadow: var(--shadow-sm);
}

/* Hamburger */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  padding: 5px;
  background: none;
  border: none;
  z-index: 1001;
}

.hamburger span {
  display: block;
  width: 26px;
  height: 2.5px;
  background: var(--text-dark);
  border-radius: 4px;
  transition: var(--transition);
}

.hamburger.active span:nth-child(1) {
  transform: rotate(45deg) translate(5px, 6px);
}

.hamburger.active span:nth-child(2) {
  opacity: 0;
}

.hamburger.active span:nth-child(3) {
  transform: rotate(-45deg) translate(5px, -6px);
}

/* =============================================
   HERO SECTION
   ============================================= */
.hero-section {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  background: var(--primary-gradient);
  overflow: hidden;
  padding: 140px 0 80px;
}

.hero-section::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 800px;
  height: 800px;
  background: rgba(170, 216, 22, 0.08);
  border-radius: 50%;
  pointer-events: none;
}

.hero-section::after {
  content: '';
  position: absolute;
  bottom: -20%;
  left: -10%;
  width: 500px;
  height: 500px;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 50%;
  pointer-events: none;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
  position: relative;
  z-index: 2;
}

.hero-content {
  color: var(--text-white);
}

.hero-content .hero-tag {
  display: inline-block;
  font-size: 0.85rem;
  font-weight: 600;
  background: rgba(170, 216, 22, 0.2);
  color: var(--secondary);
  padding: 6px 18px;
  border-radius: 50px;
  margin-bottom: 20px;
  letter-spacing: 0.5px;
  border: 1px solid rgba(170, 216, 22, 0.3);
}

.hero-content h1 {
  color: var(--text-white);
  margin-bottom: 20px;
  font-size: clamp(2.5rem, 5.5vw, 4rem);
  letter-spacing: -1px;
}

.hero-content h1 span {
  color: var(--secondary);
}

.hero-content p {
  font-size: 1.1rem;
  line-height: 1.8;
  opacity: 0.9;
  margin-bottom: 36px;
  max-width: 540px;
}

.hero-buttons {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-lg);
  padding: 40px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
}

.hero-stat-item {
  text-align: center;
  padding: 16px;
}

.hero-stat-item .stat-number {
  font-size: 2.2rem;
  font-weight: 800;
  color: var(--secondary);
  display: block;
  line-height: 1.2;
}

.hero-stat-item .stat-label {
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4px;
}

/* =============================================
   SERVICES SECTION
   ============================================= */
.services-section {
  background: var(--bg-white);
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.service-card {
  background: var(--bg-light);
  border-radius: var(--radius-lg);
  padding: 40px 30px;
  transition: var(--transition);
  border: 1px solid transparent;
  position: relative;
  overflow: hidden;
}

.service-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 0;
  background: var(--secondary-gradient);
  transition: var(--transition);
}

.service-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
  border-color: rgba(22, 11, 153, 0.08);
  background: var(--bg-white);
}

.service-card:hover::before {
  height: 100%;
}

.service-card .card-number {
  font-size: 2.5rem;
  font-weight: 800;
  color: rgba(22, 11, 153, 0.06);
  line-height: 1;
  margin-bottom: 16px;
}

.service-card h3 {
  margin-bottom: 12px;
  font-size: 1.3rem;
}

.service-card p {
  color: var(--text-light);
  font-size: 0.95rem;
  line-height: 1.7;
}

/* =============================================
   ABOUT SECTION (Home)
   ============================================= */
.about-highlight-section {
  background: var(--bg-light);
}

.about-highlight-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.about-highlight-image {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--primary-gradient);
  min-height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-highlight-image .placeholder-content {
  text-align: center;
  color: var(--text-white);
  padding: 40px;
}

.about-highlight-image .placeholder-content .brand-big {
  font-size: 3rem;
  font-weight: 800;
  letter-spacing: -1px;
}

.about-highlight-image .placeholder-content .brand-big span {
  color: var(--secondary);
}

.about-highlight-content h2 {
  margin-bottom: 20px;
}

.about-highlight-content p {
  color: var(--text-light);
  margin-bottom: 16px;
  line-height: 1.8;
}

.business-highlights {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-top: 40px;
}

.highlight-item {
  text-align: center;
  padding: 24px 16px;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-color);
  transition: var(--transition);
}

.highlight-item:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--secondary);
}

.highlight-item .highlight-number {
  font-size: 2rem;
  font-weight: 800;
  color: var(--primary);
  display: block;
  line-height: 1.2;
}

.highlight-item .highlight-label {
  font-size: 0.8rem;
  color: var(--text-light);
  margin-top: 4px;
  font-weight: 500;
}

/* =============================================
   COUNTRIES SECTION (Home)
   ============================================= */
.countries-section {
  background: var(--bg-white);
}

.country-showcase {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.country-card {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--bg-light);
  padding: 28px 20px;
  text-align: center;
  border: 1px solid var(--border-color);
  transition: var(--transition);
  cursor: pointer;
}

.country-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--primary);
}

.country-card .country-name {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 4px;
}

.country-card .country-region {
  font-size: 0.8rem;
  color: var(--text-light);
}

.country-card .country-flag-placeholder {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12px;
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-white);
}

/* =============================================
   PROCESS SECTION
   ============================================= */
.process-section {
  background: var(--bg-light);
}

.process-steps {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 24px;
  position: relative;
}

.process-step {
  text-align: center;
  padding: 30px 20px;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-color);
  transition: var(--transition);
  position: relative;
}

.process-step:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}

.process-step .step-number {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--primary-gradient-soft);
  color: var(--text-white);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
  font-size: 1.1rem;
  font-weight: 700;
}

.process-step h4 {
  font-size: 1rem;
  margin-bottom: 8px;
}

.process-step p {
  font-size: 0.85rem;
  color: var(--text-light);
  line-height: 1.6;
}

/* =============================================
   TESTIMONIALS / TRUST
   ============================================= */
.testimonials-section {
  background: var(--primary-gradient);
  color: var(--text-white);
}

.testimonials-section .section-header h2 {
  color: var(--text-white);
}

.testimonials-section .section-header p {
  color: rgba(255, 255, 255, 0.8);
}

.testimonials-section .section-tag {
  background: rgba(170, 216, 22, 0.2);
  color: var(--secondary);
}

.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.testimonial-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-lg);
  padding: 36px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
}

.testimonial-card .testimonial-text {
  font-size: 0.95rem;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20px;
  font-style: italic;
}

.testimonial-card .testimonial-author {
  font-weight: 600;
  color: var(--secondary);
}

.testimonial-card .testimonial-role {
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.6);
}

/* =============================================
   BLOG PREVIEW
   ============================================= */
.blog-grid-home {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.blog-card {
  background: var(--bg-white);
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--border-color);
  transition: var(--transition);
}

.blog-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}

.blog-card .blog-image {
  height: 200px;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
}

.blog-card .blog-image .blog-img-placeholder {
  color: rgba(255, 255, 255, 0.3);
  font-size: 0.9rem;
  letter-spacing: 1px;
}

.blog-card .blog-content {
  padding: 24px;
}

.blog-card .blog-category {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--primary);
  background: rgba(22, 11, 153, 0.08);
  padding: 4px 12px;
  border-radius: 50px;
  margin-bottom: 12px;
}

.blog-card .blog-content h3 {
  font-size: 1.1rem;
  margin-bottom: 8px;
  line-height: 1.4;
}

.blog-card .blog-content h3 a {
  color: var(--text-dark);
}

.blog-card .blog-content h3 a:hover {
  color: var(--primary);
}

.blog-card .blog-content p {
  font-size: 0.9rem;
  color: var(--text-light);
  line-height: 1.6;
  margin-bottom: 16px;
}

.blog-card .blog-meta {
  font-size: 0.8rem;
  color: var(--text-light);
}

/* =============================================
   CTA SECTION
   ============================================= */
.cta-section {
  background: var(--bg-light);
  text-align: center;
}

.cta-box {
  background: var(--primary-gradient);
  border-radius: var(--radius-xl);
  padding: 80px 40px;
  position: relative;
  overflow: hidden;
}

.cta-box::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400px;
  height: 400px;
  background: rgba(170, 216, 22, 0.08);
  border-radius: 50%;
}

.cta-box h2 {
  color: var(--text-white);
  margin-bottom: 16px;
  position: relative;
  z-index: 2;
}

.cta-box p {
  color: rgba(255, 255, 255, 0.9);
  font-size: 1.1rem;
  max-width: 600px;
  margin: 0 auto 32px;
  position: relative;
  z-index: 2;
}

.cta-box .btn {
  position: relative;
  z-index: 2;
}

/* =============================================
   FOOTER
   ============================================= */
.site-footer {
  background: var(--primary-dark);
  color: rgba(255, 255, 255, 0.85);
  padding: 80px 0 30px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 40px;
  margin-bottom: 40px;
}

.footer-brand .logo-text {
  color: var(--text-white);
  margin-bottom: 16px;
  display: inline-block;
}

.footer-brand p {
  font-size: 0.9rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.7);
  max-width: 320px;
}

.footer-column h4 {
  color: var(--text-white);
  font-size: 1rem;
  margin-bottom: 20px;
  position: relative;
}

.footer-column h4::after {
  content: '';
  display: block;
  width: 30px;
  height: 3px;
  background: var(--secondary);
  margin-top: 8px;
  border-radius: 4px;
}

.footer-column ul li {
  margin-bottom: 10px;
}

.footer-column ul li a {
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.9rem;
  transition: var(--transition);
}

.footer-column ul li a:hover {
  color: var(--secondary);
  padding-left: 4px;
}

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}

.footer-bottom p {
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.6);
}

.footer-bottom-links {
  display: flex;
  gap: 20px;
}

.footer-bottom-links a {
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.6);
}

.footer-bottom-links a:hover {
  color: var(--secondary);
}

/* =============================================
   PAGE HEADER (Inner Pages)
   ============================================= */
.page-header {
  background: var(--primary-gradient);
  padding: 140px 0 60px;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 400px;
  height: 400px;
  background: rgba(170, 216, 22, 0.08);
  border-radius: 50%;
}

.page-header h1 {
  color: var(--text-white);
  margin-bottom: 12px;
  position: relative;
  z-index: 2;
}

.page-header p {
  color: rgba(255, 255, 255, 0.85);
  font-size: 1.1rem;
  max-width: 600px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.breadcrumb {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 20px;
  font-size: 0.85rem;
  position: relative;
  z-index: 2;
}

.breadcrumb a {
  color: rgba(255, 255, 255, 0.7);
}

.breadcrumb a:hover {
  color: var(--secondary);
}

.breadcrumb span {
  color: rgba(255, 255, 255, 0.5);
}

.breadcrumb .current {
  color: var(--secondary);
}

/* =============================================
   ABOUT PAGE
   ============================================= */
.about-story-section {
  background: var(--bg-white);
}

.about-story-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.about-story-image {
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--primary-gradient);
  min-height: 380px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-story-image .about-placeholder {
  text-align: center;
  color: var(--text-white);
  padding: 40px;
}

.about-story-image .about-placeholder .about-brand {
  font-size: 2.5rem;
  font-weight: 800;
  letter-spacing: -1px;
}

.about-story-image .about-placeholder .about-brand span {
  color: var(--secondary);
}

.about-story-content h2 {
  margin-bottom: 20px;
}

.about-story-content p {
  color: var(--text-light);
  line-height: 1.8;
  margin-bottom: 16px;
}

/* Mission Vision */
.mission-vision-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.mv-card {
  background: var(--bg-light);
  border-radius: var(--radius-lg);
  padding: 40px 30px;
  text-align: center;
  border: 1px solid var(--border-color);
  transition: var(--transition);
}

.mv-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--primary);
}

.mv-card .mv-number {
  font-size: 2.5rem;
  font-weight: 800;
  color: rgba(22, 11, 153, 0.08);
  line-height: 1;
  margin-bottom: 16px;
}

.mv-card h3 {
  margin-bottom: 12px;
}

.mv-card p {
  color: var(--text-light);
  font-size: 0.95rem;
  line-height: 1.7;
}

/* Team */
.team-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.team-card {
  text-align: center;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 32px 20px;
  border: 1px solid var(--border-color);
  transition: var(--transition);
}

.team-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}

.team-card .team-avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--text-white);
}

.team-card h4 {
  margin-bottom: 4px;
  font-size: 1.1rem;
}

.team-card .team-role {
  font-size: 0.85rem;
  color: var(--primary);
  font-weight: 500;
}

.team-card p {
  font-size: 0.85rem;
  color: var(--text-light);
  margin-top: 8px;
  line-height: 1.6;
}

/* =============================================
   GUIDE PAGE
   ============================================= */
.guide-filter-section {
  background: var(--bg-white);
  padding: 40px 0 0;
}

.guide-search {
  max-width: 600px;
  margin: 0 auto 30px;
  position: relative;
}

.guide-search input {
  width: 100%;
  padding: 16px 24px;
  font-size: 1rem;
  font-family: var(--font-family);
  border: 2px solid var(--border-color);
  border-radius: 50px;
  outline: none;
  transition: var(--transition);
  background: var(--bg-light);
}

.guide-search input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(22, 11, 153, 0.08);
}

.region-filter {
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 40px;
}

.region-filter button {
  padding: 8px 22px;
  border-radius: 50px;
  border: 2px solid var(--border-color);
  background: var(--bg-white);
  font-family: var(--font-family);
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--text-body);
  cursor: pointer;
  transition: var(--transition);
}

.region-filter button:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.region-filter button.active {
  background: var(--primary);
  color: var(--text-white);
  border-color: var(--primary);
}

.countries-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  padding-bottom: 80px;
}

.country-guide-card {
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 24px 20px;
  text-align: center;
  border: 1px solid var(--border-color);
  transition: var(--transition);
  cursor: pointer;
}

.country-guide-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
  border-color: var(--primary);
}

.country-guide-card .card-flag {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--primary-gradient-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12px;
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--text-white);
}

.country-guide-card h3 {
  font-size: 1.1rem;
  margin-bottom: 4px;
}

.country-guide-card .region-tag {
  font-size: 0.78rem;
  color: var(--text-light);
  margin-bottom: 10px;
}

.country-guide-card .visa-types-tag {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--primary);
  background: rgba(22, 11, 153, 0.08);
  padding: 4px 12px;
  border-radius: 50px;
  display: inline-block;
}

/* =============================================
   COUNTRY DETAIL PAGE
   ============================================= */
.country-hero {
  background: var(--primary-gradient);
  padding: 140px 0 60px;
  position: relative;
  overflow: hidden;
}

.country-hero::before {
  content: '';
  position: absolute;
  top: -20%;
  right: -10%;
  width: 500px;
  height: 500px;
  background: rgba(170, 216, 22, 0.08);
  border-radius: 50%;
}

.country-hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
}

.country-hero-content .hero-flag-badge {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  font-size: 2rem;
  font-weight: 800;
  color: var(--text-white);
  border: 3px solid rgba(255, 255, 255, 0.2);
}

.country-hero-content h1 {
  color: var(--text-white);
  margin-bottom: 12px;
}

.country-hero-content p {
  color: rgba(255, 255, 255, 0.85);
  font-size: 1.1rem;
  max-width: 700px;
  margin: 0 auto;
}

.country-quick-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-top: 40px;
}

.country-quick-stat {
  background: rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  padding: 20px;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.country-quick-stat .qs-value {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--secondary);
  display: block;
}

.country-quick-stat .qs-label {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4px;
}

/* Country Content Sections */
.country-content-section {
  padding: 70px 0;
  background: var(--bg-white);
}

.country-content-section:nth-child(even) {
  background: var(--bg-light);
}

.country-content-section .content-header {
  margin-bottom: 36px;
}

.country-content-section .content-header h2 {
  margin-bottom: 12px;
}

.country-content-section .content-header p {
  color: var(--text-light);
  font-size: 1.05rem;
  max-width: 700px;
}

/* Visa Info Cards */
.visa-type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.visa-type-card {
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 30px;
  border: 1px solid var(--border-color);
  transition: var(--transition);
}

.visa-type-card:hover {
  box-shadow: var(--shadow-md);
  border-color: var(--primary);
}

.visa-type-card h3 {
  font-size: 1.15rem;
  margin-bottom: 10px;
  color: var(--primary);
}

.visa-type-card p {
  font-size: 0.92rem;
  color: var(--text-light);
  line-height: 1.7;
  margin-bottom: 12px;
}

.visa-type-card .visa-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--border-color);
}

.visa-type-card .visa-meta-item {
  font-size: 0.85rem;
}

.visa-type-card .visa-meta-item strong {
  display: block;
  color: var(--text-dark);
  font-size: 0.8rem;
  margin-bottom: 2px;
}

.visa-type-card .visa-meta-item span {
  color: var(--text-light);
}

/* Requirements List */
.requirements-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.requirements-list li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px 20px;
  background: var(--bg-light);
  border-radius: var(--radius-sm);
  font-size: 0.92rem;
  color: var(--text-body);
  border-left: 3px solid var(--secondary);
}

/* Process Steps */
.process-timeline {
  max-width: 800px;
  margin: 0 auto;
}

.timeline-item {
  display: flex;
  gap: 24px;
  padding-bottom: 36px;
  position: relative;
}

.timeline-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 20px;
  top: 44px;
  bottom: 0;
  width: 2px;
  background: var(--border-color);
}

.timeline-item .tl-number {
  width: 42px;
  height: 42px;
  min-width: 42px;
  border-radius: 50%;
  background: var(--primary-gradient-soft);
  color: var(--text-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.95rem;
  font-weight: 700;
  position: relative;
  z-index: 2;
}

.timeline-item .tl-content {
  padding-top: 4px;
}

.timeline-item .tl-content h4 {
  font-size: 1.05rem;
  margin-bottom: 6px;
}

.timeline-item .tl-content p {
  font-size: 0.9rem;
  color: var(--text-light);
  line-height: 1.7;
}

/* Fees Table */
.fees-table-wrapper {
  overflow-x: auto;
}

.fees-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.fees-table thead {
  background: var(--primary-gradient-soft);
}

.fees-table thead th {
  padding: 16px 20px;
  text-align: left;
  color: var(--text-white);
  font-weight: 600;
  font-size: 0.9rem;
}

.fees-table tbody td {
  padding: 14px 20px;
  border-bottom: 1px solid var(--border-color);
  font-size: 0.9rem;
}

.fees-table tbody tr:hover {
  background: rgba(22, 11, 153, 0.03);
}

.fees-table tbody tr:last-child td {
  border-bottom: none;
}

/* Embassy Link */
.embassy-link-box {
  background: var(--bg-light);
  border-radius: var(--radius-lg);
  padding: 40px;
  text-align: center;
  border: 2px dashed var(--border-color);
  transition: var(--transition);
}

.embassy-link-box:hover {
  border-color: var(--primary);
  background: rgba(22, 11, 153, 0.03);
}

.embassy-link-box h3 {
  margin-bottom: 12px;
}

.embassy-link-box p {
  color: var(--text-light);
  margin-bottom: 24px;
}

/* Country FAQ */
.country-faq-list {
  max-width: 900px;
  margin: 0 auto;
}

.faq-item {
  background: var(--bg-white);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  margin-bottom: 12px;
  overflow: hidden;
  transition: var(--transition);
}

.faq-item:hover {
  border-color: var(--primary);
}

.faq-item .faq-question {
  width: 100%;
  padding: 20px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--font-family);
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-dark);
  text-align: left;
  transition: var(--transition);
}

.faq-item .faq-question:hover {
  color: var(--primary);
}

.faq-item .faq-question .faq-toggle {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--bg-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  color: var(--text-body);
  transition: var(--transition);
  flex-shrink: 0;
}

.faq-item.active .faq-question .faq-toggle {
  background: var(--primary);
  color: var(--text-white);
  transform: rotate(45deg);
}

.faq-item .faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
}

.faq-item.active .faq-answer {
  max-height: 500px;
  padding: 0 24px 20px;
}

.faq-item .faq-answer p {
  font-size: 0.92rem;
  color: var(--text-light);
  line-height: 1.8;
}

/* Infographics */
.infographics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.infographic-card {
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 32px 24px;
  text-align: center;
  border: 1px solid var(--border-color);
  transition: var(--transition);
}

.infographic-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}

.infographic-card .infographic-value {
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--primary);
  line-height: 1.2;
  margin-bottom: 8px;
}

.infographic-card .infographic-label {
  font-size: 0.9rem;
  color: var(--text-light);
  font-weight: 500;
}

.infographic-card .infographic-desc {
  font-size: 0.85rem;
  color: var(--text-light);
  margin-top: 8px;
  line-height: 1.6;
}

/* =============================================
   BLOG PAGE
   ============================================= */
.blog-featured {
  background: var(--bg-light);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 60px;
}

.blog-featured .featured-image {
  min-height: 350px;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
}

.blog-featured .featured-image span {
  color: rgba(255, 255, 255, 0.3);
  font-size: 1rem;
}

.blog-featured .featured-content {
  padding: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.blog-featured .featured-content .featured-badge {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--primary);
  background: rgba(22, 11, 153, 0.08);
  padding: 4px 14px;
  border-radius: 50px;
  margin-bottom: 16px;
  align-self: flex-start;
}

.blog-featured .featured-content h2 {
  margin-bottom: 12px;
}

.blog-featured .featured-content h2 a {
  color: var(--text-dark);
}

.blog-featured .featured-content h2 a:hover {
  color: var(--primary);
}

.blog-featured .featured-content p {
  color: var(--text-light);
  line-height: 1.7;
  margin-bottom: 20px;
}

.blog-list-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.blog-pagination {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 60px;
}

.blog-pagination a {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1px solid var(--border-color);
  font-weight: 500;
  font-size: 0.9rem;
  transition: var(--transition);
}

.blog-pagination a:hover,
.blog-pagination a.active {
  background: var(--primary);
  color: var(--text-white);
  border-color: var(--primary);
}

/* =============================================
   CONTACT PAGE
   ============================================= */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 60px;
}

.contact-info-cards {
  display: grid;
  gap: 24px;
}

.contact-info-card {
  background: var(--bg-light);
  border-radius: var(--radius-md);
  padding: 28px 24px;
  border: 1px solid var(--border-color);
  transition: var(--transition);
}

.contact-info-card:hover {
  border-color: var(--primary);
  transform: translateX(4px);
}

.contact-info-card h3 {
  font-size: 1.05rem;
  margin-bottom: 6px;
}

.contact-info-card p {
  font-size: 0.9rem;
  color: var(--text-light);
  line-height: 1.7;
}

.contact-info-card .contact-detail {
  font-size: 1rem;
  color: var(--text-dark);
  font-weight: 500;
  margin-top: 8px;
}

.contact-form-wrapper {
  background: var(--bg-light);
  border-radius: var(--radius-lg);
  padding: 40px;
  border: 1px solid var(--border-color);
}

.contact-form-wrapper h3 {
  margin-bottom: 8px;
}

.contact-form-wrapper p {
  color: var(--text-light);
  margin-bottom: 28px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 6px;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 14px 18px;
  font-family: var(--font-family);
  font-size: 0.95rem;
  border: 2px solid var(--border-color);
  border-radius: var(--radius-sm);
  outline: none;
  transition: var(--transition);
  background: var(--bg-white);
  color: var(--text-dark);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(22, 11, 153, 0.06);
}

.form-group textarea {
  min-height: 140px;
  resize: vertical;
}

/* =============================================
   FAQ PAGE
   ============================================= */
.faq-page-list {
  max-width: 800px;
  margin: 0 auto;
}

.faq-category {
  margin-bottom: 48px;
}

.faq-category h3 {
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 2px solid var(--secondary);
}

/* =============================================
   RESPONSIVE DESIGN
   ============================================= */

/* Tablet (768px - 1024px) */
@media (max-width: 1024px) {
  .hero-grid {
    grid-template-columns: 1fr;
    gap: 40px;
    text-align: center;
  }

  .hero-content p {
    margin: 0 auto 36px;
  }

  .hero-buttons {
    justify-content: center;
  }

  .hero-stats {
    max-width: 500px;
    margin: 0 auto;
  }

  .services-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-highlight-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .country-showcase {
    grid-template-columns: repeat(3, 1fr);
  }

  .process-steps {
    grid-template-columns: repeat(3, 1fr);
  }

  .testimonials-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .blog-grid-home {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  .business-highlights {
    grid-template-columns: repeat(2, 1fr);
  }

  .mission-vision-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .team-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .countries-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .visa-type-grid {
    grid-template-columns: 1fr;
  }

  .requirements-list {
    grid-template-columns: 1fr;
  }

  .infographics-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .contact-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .blog-featured {
    grid-template-columns: 1fr;
  }

  .blog-list-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .country-quick-stats {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile (< 768px) */
@media (max-width: 767px) {
  :root {
    --header-height: 70px;
  }

  .section-padding {
    padding: 60px 0;
  }

  .hamburger {
    display: flex;
  }

  .main-nav {
    position: fixed;
    top: 0;
    right: -100%;
    width: 85%;
    max-width: 360px;
    height: 100vh;
    background: var(--bg-white);
    flex-direction: column;
    padding: 100px 30px 40px;
    gap: 4px;
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.1);
    transition: var(--transition);
    overflow-y: auto;
    align-items: stretch;
  }

  .main-nav.open {
    right: 0;
  }

  .main-nav a {
    padding: 14px 18px;
    font-size: 1rem;
    border-radius: var(--radius-sm);
  }

  .main-nav a.contact-btn-nav {
    text-align: center;
    margin-top: 12px;
  }

  .hero-section {
    padding: 120px 0 60px;
    min-height: auto;
  }

  .hero-stats {
    padding: 24px;
    gap: 12px;
  }

  .hero-stat-item .stat-number {
    font-size: 1.6rem;
  }

  .services-grid {
    grid-template-columns: 1fr;
  }

  .country-showcase {
    grid-template-columns: repeat(2, 1fr);
  }

  .process-steps {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .testimonials-grid {
    grid-template-columns: 1fr;
  }

  .blog-grid-home {
    grid-template-columns: 1fr;
  }

  .section-header {
    margin-bottom: 40px;
  }

  .section-header p {
    font-size: 1rem;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .footer-bottom {
    flex-direction: column;
    text-align: center;
    gap: 12px;
  }

  .business-highlights {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .highlight-item {
    padding: 18px 12px;
  }

  .highlight-item .highlight-number {
    font-size: 1.5rem;
  }

  .mission-vision-grid {
    grid-template-columns: 1fr;
  }

  .team-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .countries-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .region-filter button {
    font-size: 0.82rem;
    padding: 6px 16px;
  }

  .country-quick-stats {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .country-quick-stat {
    padding: 14px;
  }

  .country-quick-stat .qs-value {
    font-size: 1.1rem;
  }

  .infographics-grid {
    grid-template-columns: 1fr;
  }

  .blog-list-grid {
    grid-template-columns: 1fr;
  }

  .contact-form-wrapper {
    padding: 24px;
  }

  .cta-box {
    padding: 40px 20px;
  }

  .about-highlight-image {
    min-height: 280px;
  }

  .embassy-link-box {
    padding: 24px;
  }

  .page-header {
    padding: 120px 0 40px;
  }

  .visa-type-card {
    padding: 20px;
  }

  .fees-table thead th,
  .fees-table tbody td {
    padding: 10px 14px;
  }

  .country-card .country-flag-placeholder {
    width: 40px;
    height: 40px;
    font-size: 1rem;
  }
}

/* Small Mobile (< 480px) */
@media (max-width: 480px) {
  .hero-content h1 {
    font-size: 2rem;
  }

  .hero-buttons {
    flex-direction: column;
    align-items: center;
  }

  .hero-buttons .btn {
    width: 100%;
    max-width: 280px;
  }

  .country-showcase {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .countries-grid {
    grid-template-columns: 1fr;
  }

  .country-card {
    padding: 16px 12px;
  }

  .team-grid {
    grid-template-columns: 1fr;
  }

  .business-highlights {
    grid-template-columns: repeat(2, 1fr);
  }

  .country-quick-stats {
    grid-template-columns: 1fr 1fr;
  }

  .requirements-list li {
    padding: 12px 16px;
    font-size: 0.85rem;
  }
}

/* Nav overlay */
.nav-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transition: var(--transition);
}

.nav-overlay.active {
  opacity: 1;
  visibility: visible;
}

/* =============================================
   UTILITY CLASSES
   ============================================= */
.text-center { text-align: center; }
.text-primary { color: var(--primary); }
.text-secondary { color: var(--secondary); }
.mt-20 { margin-top: 20px; }
.mt-40 { margin-top: 40px; }
.mb-20 { margin-bottom: 20px; }
.mb-40 { margin-bottom: 40px; }
